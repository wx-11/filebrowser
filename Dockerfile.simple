FROM golang:1.24-alpine AS builder

WORKDIR /app
COPY . .

# Create dummy frontend dist directory to satisfy build requirements
RUN mkdir -p frontend/dist && echo "dummy" > frontend/dist/index.html

# Tidy and build the backend only
RUN go mod tidy && CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o filebrowser .

# Final stage - copy the built binary  
FROM alpine:latest
RUN apk --no-cache add ca-certificates
WORKDIR /root/
COPY --from=builder /app/filebrowser .
CMD ["./filebrowser"]