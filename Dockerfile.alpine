# Multi-stage build for File Browser My Branch
FROM node:18-alpine AS frontend-builder

WORKDIR /app
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN npm install -g pnpm && pnpm install --frozen-lockfile
COPY frontend/ .
RUN pnpm run build

FROM golang:1.22-alpine AS backend-builder

RUN apk add --no-cache git
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend-builder /app/dist ./frontend/dist/
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -ldflags '-s -w' -o filebrowser .

FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata && \
    adduser -D -s /bin/sh filebrowser

WORKDIR /

COPY --from=backend-builder /app/filebrowser /usr/local/bin/filebrowser

RUN mkdir -p /srv /config /database && \
    chown -R filebrowser:filebrowser /srv /config /database

USER filebrowser

VOLUME ["/srv", "/config", "/database"]

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/filebrowser"]